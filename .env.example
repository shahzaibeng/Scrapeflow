# ---------------------------------------------------------------------------
# PPRA Tenders Scraper - sample configuration
# Copy to `.env` and adjust. Every key is optional; defaults are shown.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./ppra_tenders.db
# PostgreSQL (plain postgresql:// URLs are rewritten to the asyncpg driver):
# DATABASE_URL=postgresql+asyncpg://ppra:secret@localhost:5432/ppra
DB_ECHO=false
DB_UPSERT_BATCH_SIZE=200

# --- Source portal ---------------------------------------------------------
EPMS_BASE_URL=https://epms.ppra.gov.pk
EPMS_LISTING_PATH=/public/tenders/active-tenders
# Optional XHR/JSON endpoint. When set, it is used instead of HTML listing pages.
# Use {page} as the page-number placeholder, e.g.
# JSON_API_URL=https://epms.ppra.gov.pk/api/tenders/active?page={page}
JSON_API_URL=

# --- Scraper behaviour -----------------------------------------------------
REQUEST_TIMEOUT=30
CONNECT_TIMEOUT=15
MAX_RETRIES=4
RETRY_BACKOFF_BASE=1.5
RETRY_BACKOFF_MAX=60
# Random polite delay between listing-page requests (seconds)
MIN_DELAY=1.0
MAX_DELAY=2.5
# Detail pages are fetched to obtain the PDF link + procurement category
FETCH_DETAILS=true
DETAIL_CONCURRENCY=4
DETAIL_DELAY=0.4
# Hard safety cap on listing pages (0 = unlimited)
MAX_PAGES=0
VERIFY_SSL=true
# Comma-separated list; one is chosen at random per request
USER_AGENTS=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Safari/537.36,Mozilla/5.0 (Macintosh; Intel Mac OS X 14_6) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.6 Safari/605.1.15,Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0

# --- Misc ------------------------------------------------------------------
# Timezone the portal publishes dates in
SOURCE_TIMEZONE=Asia/Karachi
LOG_LEVEL=INFO
LOG_DIR=logs
